<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Die Reservierung bekommt einen Beginn: eine verwaiste Reservierung (Absturz, Deploy, Freigabefehler) verfällt -->
    <changeSet id="039-chat-budget-reservierung-lease" author="archiv">
        <sql>
            alter table public.mandant_budget
                add column laufend_seit timestamptz;
        </sql>
        <rollback>
            <sql>alter table public.mandant_budget drop column laufend_seit;</sql>
        </rollback>
    </changeSet>
</databaseChangeLog>
