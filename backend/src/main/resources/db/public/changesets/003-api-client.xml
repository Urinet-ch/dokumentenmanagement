<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- API-Clients für Skripte (Req 2.5); Logik folgt mit Aufgabe 1.5 -->
    <changeSet id="003-api-client" author="archiv">
        <createTable tableName="api_client">
            <column name="id" type="text">
                <constraints primaryKey="true" primaryKeyName="api_client_pk"/>
            </column>
            <column name="mandant" type="text">
                <constraints nullable="false" foreignKeyName="api_client_mandant_fk" references="mandant(code)"/>
            </column>
            <column name="name" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="scope" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="geheimnis_hash" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="aktiv" type="boolean" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="erstellt" type="timestamptz" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="zuletzt" type="timestamptz"/>
        </createTable>
        <sql>
            alter table api_client add constraint api_client_scope_ck check (scope in ('generator', 'import'));
        </sql>
    </changeSet>
</databaseChangeLog>
