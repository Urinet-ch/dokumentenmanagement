<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Aufgabe 2.5 (Req 5.4): Der Handler-Hook nach dem letzten Fehlversuch ist erledigt, sobald «nachbearbeitet»
         gesetzt ist; der Aufräumer ruft ihn für FEHLER-Aufträge ohne Nachbearbeitung erneut auf (Absturz zwischen
         FEHLER-Commit und Hook). Rückwärtskompatibel: neue Spalte ohne Pflicht; ein älterer Release lässt sie leer. -->
    <changeSet id="006-auftrag-nachbearbeitet" author="archiv">
        <addColumn tableName="auftrag">
            <column name="nachbearbeitet" type="timestamptz"/>
        </addColumn>
        <sql>
            create index auftrag_ohne_nachbearbeitung_ix on auftrag (beendet)
                where status = 'FEHLER' and nachbearbeitet is null;
        </sql>
    </changeSet>

    <!-- Aufgabe 2.5: Die Nutzlast ist immer ein JSON-Objekt (oder leer); der Worker liest sie Zeile für Zeile, eine
         ungültige Zeile geht auf FEHLER, ohne Poller und Aufräumer für alle Mandanten aufzuhalten. Rückwärtskompatibel:
         Auch ältere Releases schreiben die Nutzlast nur als Objekt (Nutzlast). -->
    <changeSet id="006-auftrag-nutzlast-objekt" author="archiv">
        <sql>
            alter table auftrag add constraint auftrag_nutzlast_ck
                check (nutzlast is null or jsonb_typeof(nutzlast) = 'object');
        </sql>
    </changeSet>
</databaseChangeLog>
