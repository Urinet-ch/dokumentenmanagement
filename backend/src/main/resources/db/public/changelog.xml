<?xml version="1.0" encoding="UTF-8"?>
<!-- Gemeinsame Tabellen (Mandantenregister, Aufträge, API-Clients) ab Aufgabe 1.3. Bestehende Changesets nie ändern,
     nur neue Dateien unter changesets/ anhängen (tech.md Regel 11). -->
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <include file="changesets/001-mandant.xml" relativeToChangelogFile="true"/>
    <include file="changesets/002-auftrag.xml" relativeToChangelogFile="true"/>
    <include file="changesets/003-api-client.xml" relativeToChangelogFile="true"/>
    <include file="changesets/004-mandant-checks.xml" relativeToChangelogFile="true"/>
    <include file="changesets/005-auftrag-mandant-pflicht.xml" relativeToChangelogFile="true"/>
</databaseChangeLog>
