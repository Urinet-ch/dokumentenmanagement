{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:urinet:oeffentlicher-chat-pruefliste",
  "title": "Prüfliste des öffentlichen Chatbots (Spec 03, Aufgabe 11.3)",
  "description": "Die echten Fragen liegen ausserhalb des Repositorys. Im Repository stehen nur Schema und Fake-Server-Test.",
  "type": "array",
  "minItems": 40,
  "maxItems": 60,
  "items": { "$ref": "#/$defs/frage" },
  "$defs": {
    "frage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nr", "frage", "erwartet"],
      "properties": {
        "nr": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "frage": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "erwartet": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kernwerte", "quellen"],
          "properties": {
            "kernwerte": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "quellen": {
              "description": "Leer bei Fragen ohne Beleg: Dann erwartet die Prüfung keine Quelle und die Kernwerte prüfen den Hinweis auf die Geschäftsstelle.",
              "type": "array",
              "minItems": 0,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["dokument", "titel", "reihe", "ausgabe", "jahr", "seite"],
                "properties": {
                  "dokument": { "type": "string", "format": "uuid" },
                  "titel": { "type": "string", "minLength": 1 },
                  "reihe": { "type": "string", "minLength": 1 },
                  "ausgabe": { "type": "string", "minLength": 1 },
                  "jahr": { "type": "integer", "minimum": 1, "maximum": 9999 },
                  "seite": { "type": "string", "pattern": "^[1-9][0-9]*(?:-[1-9][0-9]*)?$" }
                }
              }
            }
          }
        }
      }
    }
  }
}
