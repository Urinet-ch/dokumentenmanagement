<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>ch.urinet.archiv</groupId>
    <artifactId>archiv-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>UriNet Archiv – Backend</name>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <maven.compiler.parameters>true</maven.compiler.parameters>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!-- Quarkus 3.40 LTS; 3.40.1.2 ist das aktuelle Patch-Release (CVE-Fixes) -->
        <quarkus.platform.version>3.40.1.2</quarkus.platform.version>
        <quinoa.version>2.9.3</quinoa.version>
        <quarkus-cucumber.version>1.4.0</quarkus-cucumber.version>
        <archunit.version>1.5.1</archunit.version>
        <assertj.version>3.27.7</assertj.version>
        <pdfbox.version>3.0.8</pdfbox.version>
        <verapdf.version>1.30.4</verapdf.version>
        <compiler-plugin.version>3.16.0</compiler-plugin.version>
        <surefire-plugin.version>3.6.1</surefire-plugin.version>
        <spotbugs-plugin.version>4.10.5.0</spotbugs-plugin.version>
        <build-helper-plugin.version>3.7.0</build-helper-plugin.version>
        <!-- 3.x braucht Jackson 3 (tools.jackson) neben dem Jackson 2 von Quarkus; nur der Schema-Prüfer nutzt es (Jackson3Baum).
             Jackson 3 kommt nur transitiv über diese Bibliothek (Version bestimmt sie, Dependabot hebt es nicht selbst):
             Sicherheitsmeldungen zu tools.jackson betreffen darum dieses Update (Review PR #83, Kann 3). -->
        <json-schema-validator.version>3.0.9</json-schema-validator.version>
        <tika.version>4.2.0</tika.version>
        <commons-csv.version>1.14.1</commons-csv.version>
        <icu4j.version>79.1</icu4j.version>
        <!-- Swiss QR Code (Aufgabe 3.2, Req 7.11): dieselbe Version wie im Golden-Lauf (spikes/golden-lauf) -->
        <zxing.version>3.5.4</zxing.version>
        <wiremock.version>3.13.0</wiremock.version>
        <greenmail.version>2.1.15</greenmail.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.quarkus.platform</groupId>
                <artifactId>quarkus-bom</artifactId>
                <version>${quarkus.platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.quarkus.platform</groupId>
                <artifactId>quarkus-langchain4j-bom</artifactId>
                <version>${quarkus.platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.quarkus.platform</groupId>
                <artifactId>quarkus-amazon-services-bom</artifactId>
                <version>${quarkus.platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest-jackson</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-hibernate-orm-panache</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-jdbc-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-liquibase</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-oidc</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-openapi</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-health</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-micrometer-registry-prometheus</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-scheduler</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-mailer</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-logging-json</artifactId>
        </dependency>
        <!-- E-Mail-Eingang per IMAP (Spec 02, Aufgabe 6.1): quarkus-mailer kann kein IMAP; Version aus dem Quarkus-BOM -->
        <dependency>
            <groupId>org.eclipse.angus</groupId>
            <artifactId>angus-mail</artifactId>
        </dependency>
        <!-- PDF aus dem Text einer Mail ohne Anhang (Spec 02, Aufgabe 6.1); bisher nur in Tests -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>${pdfbox.version}</version>
        </dependency>
        <!-- Secret-Dateien unter /run/secrets als Konfiguration (tech.md Regel 7); Version aus dem Quarkus-BOM -->
        <dependency>
            <groupId>io.smallrye.config</groupId>
            <artifactId>smallrye-config-source-file-system</artifactId>
        </dependency>
        <!-- Argon2id für API-Tokens (Aufgabe 1.5); Version aus dem Quarkus-BOM -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
        </dependency>
        <!-- RFC-3161-Zeitstempel, OCSP und CRL des Tages-Manifests (Aufgabe 5.2); Version aus dem Quarkus-BOM -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcpkix-jdk18on</artifactId>
        </dependency>
        <!-- JSON Schema Draft 2020-12 für zusatz_schema (Aufgabe 2.1, Req 9.5) -->
        <dependency>
            <groupId>com.networknt</groupId>
            <artifactId>json-schema-validator</artifactId>
            <version>${json-schema-validator.version}</version>
        </dependency>
        <!-- Dateityp am Inhalt (Magic Bytes) beim Upload (Aufgabe 2.4, Req 3.3); nur der Detektor, keine Parser -->
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-core</artifactId>
            <version>${tika.version}</version>
        </dependency>
        <dependency>
            <groupId>io.quarkiverse.amazonservices</groupId>
            <artifactId>quarkus-amazon-s3</artifactId>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>url-connection-client</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkiverse.langchain4j</groupId>
            <artifactId>quarkus-langchain4j-openai</artifactId>
        </dependency>
        <!-- CSV-Import (Aufgabe 4.1): Parser nach RFC 4180 und Zeichensatz-Erkennung, nicht im Quarkus-BOM -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-csv</artifactId>
            <version>${commons-csv.version}</version>
        </dependency>
        <dependency>
            <groupId>com.ibm.icu</groupId>
            <artifactId>icu4j</artifactId>
            <version>${icu4j.version}</version>
        </dependency>
        <!-- Swiss QR Code (Aufgabe 3.2, Req 7.11); javase nur für BufferedImageLuminanceSource, ohne Kommandozeile -->
        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>core</artifactId>
            <version>${zxing.version}</version>
        </dependency>
        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>javase</artifactId>
            <version>${zxing.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>org.jcommander</groupId>
                    <artifactId>jcommander</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.github.jai-imageio</groupId>
                    <artifactId>jai-imageio-core</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>io.quarkiverse.quinoa</groupId>
            <artifactId>quarkus-quinoa</artifactId>
            <version>${quinoa.version}</version>
        </dependency>

        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.quarkiverse.cucumber</groupId>
            <artifactId>quarkus-cucumber</artifactId>
            <version>${quarkus-cucumber.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Drive-Import (tools/drive_import, Aufgabe 4.8): Quellen als Testquellen, Szenarien laufen in-process -->
        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- JAX-RS-Scanner von smallrye-open-api (Version aus der Quarkus-BOM, dieselbe wie im Build): PublicVertragTest
             erzeugt den Vertrag /public/ ohne Quarkus-Start (Spec 03, Aufgabe 11.6) -->
        <dependency>
            <groupId>io.smallrye</groupId>
            <artifactId>smallrye-open-api-jaxrs</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- KI-Aufrufe in Tests nur gegen WireMock (Aufgabe 3.2, tech.md «Tests und Qualität»; nicht im Quarkus-BOM);
             ebenso die Stubs der Zeitstempeldienste (Aufgabe 5.2), nie echte TSA-Aufrufe aus Tests -->
        <dependency>
            <groupId>org.wiremock</groupId>
            <artifactId>wiremock-standalone</artifactId>
            <version>${wiremock.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- OCR-Adapter (Aufgabe 2.6): synthetische Test-PDFs (Textebene, verschlüsselt, signiert) und PDF/A-Prüfung -->
        <!-- IMAP-Server für die Szenarien des Mail-Eingangs (Spec 02, design.md «Testing Strategy») -->
        <dependency>
            <groupId>com.icegreen</groupId>
            <artifactId>greenmail</artifactId>
            <version>${greenmail.version}</version>
            <scope>test</scope>
            <exclusions>
                <!-- Jakarta Mail kommt über angus-mail -->
                <exclusion>
                    <groupId>org.eclipse.angus</groupId>
                    <artifactId>jakarta.mail</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.verapdf</groupId>
            <artifactId>validation-model-jakarta</artifactId>
            <version>${verapdf.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!-- Öffentlicher Manifest-Schlüssel (Req 15.12): eine Quelle unter docs/, im Artefakt für das Prüfwerkzeug -->
            <resource>
                <directory>${project.basedir}/../docs</directory>
                <targetPath>manifest</targetPath>
                <includes>
                    <include>manifest-schluessel.pub.pem</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>io.quarkus.platform</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <version>${quarkus.platform.version}</version>
                <extensions>true</extensions>
                <executions>
                    <execution>
                        <goals>
                            <goal>build</goal>
                            <goal>generate-code</goal>
                            <goal>generate-code-tests</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!-- Drive-Import (Aufgabe 4.8): die Cucumber-Szenarien @req-12.x rufen das Werkzeug direkt auf -->
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>${build-helper-plugin.version}</version>
                <executions>
                    <execution>
                        <id>drive-import-quellen</id>
                        <phase>generate-test-sources</phase>
                        <goals>
                            <goal>add-test-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${project.basedir}/../tools/drive_import/src/main/java</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${compiler-plugin.version}</version>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire-plugin.version}</version>
                <configuration>
                    <systemPropertyVariables>
                        <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                    </systemPropertyVariables>
                    <excludes>
                        <exclude>**/*KnapperHeapTest.java</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <!-- Aufgabe 3.2 (Review PR #93, M3): Seitenbilder und Swiss QR Code mit knappem Heap; Stufe A hat
                         -Xmx112m, davon braucht die übrige API den grösseren Teil -->
                    <execution>
                        <id>speicher</id>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <excludes combine.self="override"/>
                            <includes>
                                <include>**/*KnapperHeapTest.java</include>
                            </includes>
                            <!-- fest, damit -Dtest=… keine anderen Tests in diesen Fork holt -->
                            <test>*KnapperHeapTest</test>
                            <failIfNoSpecifiedTests>false</failIfNoSpecifiedTests>
                            <argLine>-Xmx64m -Djava.awt.headless=true</argLine>
                            <systemPropertyVariables>
                                <archiv.speicher-test>true</archiv.speicher-test>
                            </systemPropertyVariables>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!-- Definition of Done (tech.md): keine neuen SpotBugs-Funde der Stufe hoch -->
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <version>${spotbugs-plugin.version}</version>
                <configuration>
                    <threshold>High</threshold>
                    <failOnError>true</failOnError>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
