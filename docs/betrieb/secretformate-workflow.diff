+          if [ -n "$ARCHIV_MANIFEST_KEY" ] &&
+             ! (set -o pipefail; printf '%s' "$ARCHIV_MANIFEST_KEY" | openssl pkey -pubout -outform DER 2>/dev/null |
+               openssl asn1parse -inform DER 2>/dev/null | grep -q 'OBJECT *:ED25519'); then
+            echo "::error::ARCHIV_MANIFEST_KEY muss ein privater Ed25519-Schlüssel im PKCS#8-PEM-Format sein"; fehlt=1
