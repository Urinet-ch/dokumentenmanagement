           NAMENSSPERRE_SALZ: ${{ secrets.NAMENSSPERRE_SALZ }}
           KEYCLOAK_VERWALTUNG_SECRET: ${{ secrets.KEYCLOAK_VERWALTUNG_SECRET }}
           KEYCLOAK_SMTP_PASSWORT: ${{ secrets.KEYCLOAK_SMTP_PASSWORT }}
@@ -107,5 +108,19 @@ jobs:
-          # Format: Die Migration der Namenssperre und der Start der API brechen sonst erst nach Minuten ab (Deploy 22./23.11.2026)
-          if [ -n "$NAMENSSPERRE_SALZ" ] && [ "$(printf '%s' "$NAMENSSPERRE_SALZ" | tr -d '[:space:]' | base64 -d 2>/dev/null | wc -c | tr -d ' ')" != 32 ]; then
