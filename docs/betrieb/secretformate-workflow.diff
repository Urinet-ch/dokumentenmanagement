           S3_APP_ZUGANG_GEHEIMNIS: ${{ secrets.S3_APP_ZUGANG_GEHEIMNIS }}
           INFOMANIAK_AI_TOKEN: ${{ secrets.INFOMANIAK_AI_TOKEN }}
           ARCHIV_MANIFEST_KEY: ${{ secrets.ARCHIV_MANIFEST_KEY }}
