+          pruefe_32() {
+            if [[ ! "$2" =~ ^[A-Za-z0-9+/]{43}=$ ]] ||
+               ! groesse="$(set -o pipefail; printf '%s' "$2" | base64 -d 2>/dev/null | wc -c)" ||
+               [ "$groesse" -ne 32 ]; then
+              echo "::error::$1 muss Standard-Base64 für genau 32 Bytes sein (openssl rand -base64 32)"; fehlt=1
+            fi
+          }
+          if [ -n "$NAMENSSPERRE_SALZ" ]; then
+            pruefe_32 NAMENSSPERRE_SALZ "$NAMENSSPERRE_SALZ"
           fi
