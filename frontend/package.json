{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "node scripts/ng-build.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "api:generieren": "node scripts/api-leeren.mjs && openapi-generator-cli generate -i openapi/openapi.yaml -g typescript-angular -o src/app/gemeinsam/api --additional-properties=ngVersion=22.2.6,fileNaming=kebab-case",
    "e2e": "cucumber-js",
    "pruefe:build-info": "node --test scripts/ng-build.test.mjs",
    "pruefe:gestaltung": "node --test scripts/pruefe-gestaltung.test.mjs && node scripts/pruefe-gestaltung.mjs"
  },
  "private": true,
  "packageManager": "npm@10.9.8",
  "dependencies": {
    "@angular/cdk": "22.3.0",
    "@angular/common": "22.3.0",
    "@angular/compiler": "22.3.0",
    "@angular/core": "22.3.0",
    "@angular/forms": "22.3.0",
    "@angular/material": "22.3.0",
    "@angular/platform-browser": "22.3.0",
    "@angular/router": "22.3.0",
    "@angular/service-worker": "22.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@techstark/opencv-js": "4.12.0-release.1",
    "idb": "8.0.4",
    "jscanify": "1.4.3",
    "rxjs": "7.8.2",
    "tslib": "2.9.1"
  },
  "devDependencies": {
    "@angular/build": "22.3.0",
    "@angular/cli": "22.3.0",
    "@angular/compiler-cli": "22.3.0",
    "@cucumber/cucumber": "13.3.0",
    "@openapitools/openapi-generator-cli": "2.43.0",
    "axe-core": "4.14.1",
    "jsdom": "31.0.0",
    "playwright": "1.65.1",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
