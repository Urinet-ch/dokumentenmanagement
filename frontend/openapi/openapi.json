{
  "components" : {
    "schemas" : {
      "ApiToken" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string"
          },
          "name" : {
            "type" : "string"
          },
          "scope" : {
            "type" : "string",
            "enum" : [ "generator", "import" ]
          },
          "aktiv" : {
            "type" : "boolean"
          },
          "erstellt" : {
            "$ref" : "#/components/schemas/Instant"
          },
          "zuletzt" : {
            "type" : [ "string", "null" ],
            "anyOf" : [ {
              "$ref" : "#/components/schemas/Instant"
            }, {
              "type" : "null"
            } ]
          }
        }
      },
      "ApiTokenErstellt" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string"
          },
          "name" : {
            "type" : "string"
          },
          "scope" : {
            "type" : "string",
            "enum" : [ "generator", "import" ]
          },
          "erstellt" : {
            "$ref" : "#/components/schemas/Instant"
          },
          "token" : {
            "type" : "string",
            "description" : "Das Token `ua_<id>_<geheimnis>`; wird nur dieses eine Mal ausgegeben."
          }
        }
      },
      "ApiTokenNeu" : {
        "type" : "object",
        "required" : [ "name", "scope" ],
        "properties" : {
          "name" : {
            "type" : "string",
            "maxLength" : 100,
            "description" : "Bezeichnung, z. B. «Rechnungsgenerator»"
          },
          "scope" : {
            "type" : "string",
            "enum" : [ "generator", "import" ]
          }
        }
      },
      "Dokumentart" : {
        "type" : "object",
        "required" : [ "code", "name", "gruppen", "pflichtfelder", "zusatzSchema", "vertraulichkeit", "gesetzlichePflicht", "aktiv" ],
        "properties" : {
          "code" : {
            "type" : "string",
            "pattern" : "^[A-Z][A-Z0-9_]{1,39}$"
          },
          "name" : {
            "type" : "string",
            "maxLength" : 100
          },
          "beschreibung" : {
            "type" : [ "string", "null" ],
            "maxLength" : 1000,
            "description" : "Abgrenzung zu ähnlichen Arten; geht in den KI-Prompt (Req 9.2)"
          },
          "gruppen" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            },
            "description" : "Teilmenge von finanz, vertrag, frei"
          },
          "pflichtfelder" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            },
            "description" : "Felder des Dokuments oder zusatz.<feld>"
          },
          "zusatzSchema" : {
            "description" : "JSON Schema Draft 2020-12 der Zusatzfelder",
            "type" : "object",
            "$ref" : "#/components/schemas/JsonObjekt"
          },
          "vertraulichkeit" : {
            "type" : "string",
            "enum" : [ "NORMAL", "INTERN", "PERSONAL" ]
          },
          "aufbewahrungJahre" : {
            "type" : [ "integer", "null" ],
            "format" : "int32",
            "maximum" : 100,
            "minimum" : 1,
            "description" : "null = unbefristet"
          },
          "aufbewahrungAb" : {
            "type" : [ "string", "null" ],
            "enum" : [ "GESCHAEFTSJAHR", "GUELTIG_BIS" ]
          },
          "gesetzlichePflicht" : {
            "type" : "boolean"
          },
          "aktiv" : {
            "type" : "boolean"
          }
        }
      },
      "DokumentartAenderung" : {
        "description" : "Beim Anlegen sind code, name, vertraulichkeit, gesetzlichePflicht und aufbewahrungJahre Pflicht; beim Ändern ersetzen die angegebenen Felder die bisherigen. Unbekannte Felder → 400.",
        "type" : "object",
        "properties" : {
          "code" : {
            "type" : "string"
          },
          "name" : {
            "type" : "string"
          },
          "beschreibung" : {
            "type" : [ "string", "null" ]
          },
          "gruppen" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            }
          },
          "pflichtfelder" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            }
          },
          "zusatzSchema" : {
            "$ref" : "#/components/schemas/JsonObjekt"
          },
          "vertraulichkeit" : {
            "type" : "string",
            "enum" : [ "NORMAL", "INTERN", "PERSONAL" ]
          },
          "aufbewahrungJahre" : {
            "type" : [ "integer", "null" ],
            "format" : "int32",
            "maximum" : 100,
            "minimum" : 1
          },
          "aufbewahrungAb" : {
            "type" : [ "string", "null" ],
            "enum" : [ "GESCHAEFTSJAHR", "GUELTIG_BIS" ]
          },
          "gesetzlichePflicht" : {
            "type" : "boolean"
          },
          "aktiv" : {
            "type" : "boolean"
          }
        }
      },
      "Instant" : {
        "type" : "string",
        "format" : "date-time",
        "examples" : [ "2022-03-10T16:15:50Z" ]
      },
      "JsonObjekt" : {
        "type" : "object"
      }
    },
    "securitySchemes" : {
      "SecurityScheme" : {
        "type" : "openIdConnect",
        "openIdConnectUrl" : "https://archiv-auth.apps.urinet.ch/realms/urinet-archiv/.well-known/openid-configuration",
        "description" : "Authentication"
      }
    }
  },
  "openapi" : "3.1.0",
  "tags" : [ {
    "name" : "API-Tokens"
  }, {
    "name" : "Dokumentarten"
  } ],
  "paths" : {
    "/api/v1/api-tokens" : {
      "get" : {
        "summary" : "API-Tokens des Mandanten auflisten (ohne Geheimnis)",
        "tags" : [ "API-Tokens" ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/ApiToken"
                  }
                }
              }
            }
          },
          "401" : {
            "description" : "Not Authorized"
          },
          "403" : {
            "description" : "Not Allowed"
          }
        },
        "security" : [ {
          "SecurityScheme" : [ "inhaber" ]
        } ]
      },
      "post" : {
        "summary" : "API-Token anlegen",
        "description" : "Das Token steht nur in dieser Antwort.",
        "tags" : [ "API-Tokens" ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/ApiTokenNeu"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "description" : "Angelegt",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiTokenErstellt"
                }
              }
            }
          },
          "401" : {
            "description" : "Not Authorized"
          },
          "403" : {
            "description" : "Not Allowed"
          },
          "400" : {
            "description" : "Bad Request"
          }
        },
        "security" : [ {
          "SecurityScheme" : [ "inhaber" ]
        } ]
      }
    },
    "/api/v1/api-tokens/{tokenId}" : {
      "delete" : {
        "summary" : "API-Token widerrufen",
        "description" : "Wirkt sofort; fremde oder unbekannte IDs → 404.",
        "tags" : [ "API-Tokens" ],
        "parameters" : [ {
          "name" : "tokenId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "204" : {
            "description" : "Widerrufen"
          },
          "401" : {
            "description" : "Not Authorized"
          },
          "403" : {
            "description" : "Not Allowed"
          }
        },
        "security" : [ {
          "SecurityScheme" : [ "inhaber" ]
        } ]
      }
    },
    "/api/v1/dokumentarten" : {
      "get" : {
        "summary" : "Dokumentarten des Mandanten auflisten (aktive und inaktive)",
        "tags" : [ "Dokumentarten" ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/Dokumentart"
                  }
                }
              }
            }
          },
          "401" : {
            "description" : "Not Authorized"
          },
          "403" : {
            "description" : "Not Allowed"
          }
        },
        "security" : [ {
          "SecurityScheme" : [ "inhaber", "mitarbeiter", "treuhaender", "geschaeftsstelle" ]
        } ]
      },
      "post" : {
        "summary" : "Dokumentart anlegen",
        "description" : "Ungültiges Zusatz-Schema → 422 ZUSATZ_UNGUELTIG; vergebener Code → 400.",
        "tags" : [ "Dokumentarten" ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/DokumentartAenderung"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "description" : "Angelegt",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Dokumentart"
                }
              }
            }
          },
          "401" : {
            "description" : "Not Authorized"
          },
          "403" : {
            "description" : "Not Allowed"
          },
          "400" : {
            "description" : "Bad Request"
          }
        },
        "security" : [ {
          "SecurityScheme" : [ "inhaber" ]
        } ]
      }
    },
    "/api/v1/dokumentarten/{code}" : {
      "delete" : {
        "summary" : "Dokumentart löschen",
        "description" : "Nur ohne Dokumente (auch verworfene); sonst 409 DOKUMENTART_IN_GEBRAUCH.",
        "tags" : [ "Dokumentarten" ],
        "parameters" : [ {
          "name" : "code",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "204" : {
            "description" : "Gelöscht"
          },
          "401" : {
            "description" : "Not Authorized"
          },
          "403" : {
            "description" : "Not Allowed"
          }
        },
        "security" : [ {
          "SecurityScheme" : [ "inhaber" ]
        } ]
      },
      "patch" : {
        "summary" : "Dokumentart ändern oder deaktivieren",
        "description" : "Angegebene Felder ersetzen die bisherigen; der Code bleibt. aktiv=false deaktiviert.",
        "tags" : [ "Dokumentarten" ],
        "parameters" : [ {
          "name" : "code",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/DokumentartAenderung"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Dokumentart"
                }
              }
            }
          },
          "401" : {
            "description" : "Not Authorized"
          },
          "403" : {
            "description" : "Not Allowed"
          }
        },
        "security" : [ {
          "SecurityScheme" : [ "inhaber" ]
        } ]
      }
    }
  },
  "info" : {
    "title" : "UriNet Archiv API",
    "version" : "v1"
  }
}